{
  "name": "sunday-school-grading-system",
  "version": "1.0.0",
  "private": true,
  "description": "Sunday School Student Grading Management System (የሰንበት ትምህርት ቤት የተማሪዎች ውጤት አስተዳደር ሥርዓት)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=20.x"
  },
  "scripts": {
    "install:all": "npm install",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run build:server && npm run build:client",
    "start": "npm run start --prefix server",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:validate": "npm run prisma:validate --prefix server",
    "prisma:migrate": "npm run prisma:migrate --prefix server",
    "prisma:deploy": "npm run prisma:deploy --prefix server",
    "prisma:seed": "npm run prisma:seed --prefix server",
    "bootstrap:superadmin": "npm run bootstrap:superadmin --prefix server",
    "prisma:studio": "npm run prisma:studio --prefix server",
    "neon:plan": "neon config plan",
    "neon:deploy": "neon deploy",
    "neon:env": "neon env pull",
    "test:grading": "npm run test:grading --prefix server",
    "test:scheme": "npm run test:scheme --prefix server",
    "test:phase4b": "npm run test:phase4b --prefix server",
    "test:phase6": "npm run test:phase6 --prefix server",
    "test:security": "npm run test:security --prefix server",
    "test:scenarios": "npm run test:scenarios --prefix server",
    "test:qa": "npm run test:qa --prefix server",
    "test:frontend": "npm run test:frontend --prefix server",
    "test:all": "npm run test:all --prefix server"
  },
  "keywords": [
    "sunday-school",
    "grading-management",
    "amharic",
    "react",
    "express",
    "postgresql",
    "prisma"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@neon/config": "^1.13.0",
    "@neon/env": "^2.1.0"
  }
}
