{
  "name": "sunday-school-grading-server",
  "version": "1.0.0",
  "description": "Backend API for Sunday School Student Grading Management System",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test:grading": "node --experimental-strip-types src/tests/gradeWorkflow.test.ts",
    "test:scheme": "node --experimental-strip-types src/tests/phase4aGradingScheme.test.ts",
    "test:phase4b": "node --experimental-strip-types src/tests/phase4bIntegration.test.ts",
    "test:phase6": "node --experimental-strip-types src/tests/phase6Workflow.test.ts",
    "test:security": "node --experimental-strip-types src/tests/securityVerification.test.ts",
    "test:scenarios": "node --experimental-strip-types src/tests/functionalScenarios.test.ts",
    "test:qa": "node --experimental-strip-types src/tests/qaFullSystemReview.test.ts",
    "test:frontend": "node --experimental-strip-types src/tests/frontendVerification.test.ts",
    "test:all": "node --experimental-strip-types src/tests/gradeWorkflow.test.ts && node --experimental-strip-types src/tests/phase4aGradingScheme.test.ts && node --experimental-strip-types src/tests/phase4bIntegration.test.ts && node --experimental-strip-types src/tests/phase6Workflow.test.ts && node --experimental-strip-types src/tests/securityVerification.test.ts && node --experimental-strip-types src/tests/functionalScenarios.test.ts && node --experimental-strip-types src/tests/qaFullSystemReview.test.ts && node --experimental-strip-types src/tests/frontendVerification.test.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.5",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
